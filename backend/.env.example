# FlowForge AI Backend - Environment Configuration Example
# Copy this file to .env and fill in your values. Never commit .env to source control.

# Application
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL with psycopg3 driver, or SQLite for local dev/testing)
# PostgreSQL format: postgresql+psycopg://user:password@localhost:5432/flowforge
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/flowforge

# Security & Authentication
# Generate a secure 64-char hex key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_secret_key_at_least_32_chars_long
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# AI Engine / OpenAI
# Leave empty to run AI Engine in offline mock mode
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_ENGINE_USE_MOCK=true

# PayPal Sandbox API (Orders API v2)
# Obtain credentials from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=replace_with_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=replace_with_paypal_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=replace_with_registered_webhook_id

# Email Delivery (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@flowforge.ai
SMTP_FROM_NAME="FlowForge AI Operations"
EMAIL_ENABLED=false

